# Keep Unity's text serialization consistent across Windows and other platforms.
* text=auto
*.cs text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.mat text eol=lf
*.asset text eol=lf
*.fbx binary
*.png binary
*.wav binary
*.ogg binary
*.docx binary
